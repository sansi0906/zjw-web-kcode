# 测试环境配置（复制为 .env 后按需修改；.env 已被 .gitignore 忽略）
# 环境只有两套，不存在第三套：
#   test -> 默认 http://127.0.0.1:3200/（可用 TEST_BASE_URL 覆盖为内网/联调地址）
#   prod -> https://www.tjjzcy.com/
TEST_ENV=test
# 被测站点地址：内网/联调地址请在此填写，不要写入仓库
# 例如：TEST_BASE_URL=http://<your-test-host>:3200/
TEST_BASE_URL=http://127.0.0.1:3200/

# 需要登录态的用例使用（不填则相关用例按前提跳过）
# TEST_LOGIN_ACCOUNT=
# TEST_LOGIN_PASSWORD=

# 浏览器配置
BROWSER_HEADLESS=true
# 每次动作额外延迟毫秒数，本地调试可视化时可设 200~500，CI 建议 0
BROWSER_SLOW_MO=0
BROWSER_TIMEOUT=30000
BROWSER_TYPE=chromium
VIEWPORT_WIDTH=1920
VIEWPORT_HEIGHT=1080

# 测试执行配置
SCREENSHOT_ON_FAILURE=true
# 失败重试次数与间隔（秒）
RERUNS=1
RERUNS_DELAY=2
# 并行进程数，1=不并行
PARALLEL_WORKERS=1

# 报告目录（相对路径按项目根目录解析）
REPORTS_DIR=reports
LOGS_DIR=logs

# 平台/设备
# PLATFORM=web        # web / h5 / mobile
# DEVICE=             # Playwright 设备名，如 iPhone 12

# 测试人员信息（写入 Allure 环境信息）
TESTER=
REMARK=