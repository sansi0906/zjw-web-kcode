# 测试环境配置
# 环境只有两套，不存在第三套：
#   test -> http://172.16.1.165:3200/   （默认）
#   prod -> https://www.tjjzcy.com/
TEST_ENV=test
# 可选：临时覆盖上面的环境默认地址（留空则使用 TEST_ENV 对应地址）
# TEST_BASE_URL=http://172.16.1.165:3200/

# 浏览器配置
BROWSER_HEADLESS=true
# 每次动作额外延迟毫秒数，本地调试可视化时可设 200~500，CI 建议 0
BROWSER_SLOW_MO=0
BROWSER_TIMEOUT=30000
BROWSER_TYPE=chromium
VIEWPORT_WIDTH=1920
VIEWPORT_HEIGHT=1080

# 测试执行配置
SCREENSHOT_ON_FAILURE=true
# 失败重试次数与间隔（秒）
RERUNS=1
RERUNS_DELAY=2
# 并行进程数，1=不并行
PARALLEL_WORKERS=1

# 报告目录（相对路径按项目根目录解析）
REPORTS_DIR=reports
LOGS_DIR=logs

# 平台/设备
# PLATFORM=web        # web / h5 / mobile
# DEVICE=             # Playwright 设备名，如 iPhone 12

# 测试人员信息（写入 Allure 环境信息）
TESTER=
REMARK=
