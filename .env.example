# 测试环境配置
TEST_ENV=dev
TEST_BASE_URL=http://172.16.1.165:3200/

# 浏览器配置
BROWSER_HEADLESS=false
BROWSER_SLOW_MO=500
BROWSER_TIMEOUT=30000
VIEWPORT_WIDTH=1920
VIEWPORT_HEIGHT=1080
BROWSER_TYPE=chromium

# 测试执行配置
SCREENSHOT_ON_FAILURE=true
SCREENSHOT_ON_PASS=false
RERUNS=1
RERUNS_DELAY=2
PARALLEL_WORKERS=1

# 报告目录
REPORTS_DIR=reports
SCREENSHOTS_DIR=reports/screenshots
LOGS_DIR=logs

# 测试人员信息
TESTER=
REMARK=
